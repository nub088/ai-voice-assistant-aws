# Anthropic (used by Pipecat AnthropicLLMService and /demo text chat)
ANTHROPIC_API_KEY=

# Deepgram (streaming STT)
DEEPGRAM_API_KEY=

# Cartesia (streaming TTS)
CARTESIA_API_KEY=
# Sonic voice ID, pick one from https://play.cartesia.ai/voices
CARTESIA_VOICE_ID=

# Twilio (Programmable Voice + Media Streams)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public host the Twilio webhook should reach. On fly.io this is <app>.fly.dev.
# Leave blank in dev, voice routes will derive it from the inbound request host.
PUBLIC_BASE_URL=

# Twilio SMS notifications (post-call). Required to enable customer
# confirmation + owner emergency alerts. Use the same Twilio number as voice
# (must be SMS-capable) or a dedicated SMS-enabled number, in E.164 format.
TWILIO_SMS_FROM=
# Owner phone for urgency=emergency alerts (E.164, e.g. +16045551234). Leave
# blank to disable owner pages, customer confirmations still send.
OWNER_NOTIFY_NUMBER=

# Apps Script web-app endpoint (booking-intake mirror)
APPS_SCRIPT_WEB_APP_URL=

# AWS (use a profile or these vars; profile preferred for local dev)
AWS_PROFILE=ai-receptionist
AWS_REGION=ca-central-1

# S3 / KMS (populated after Terraform apply)
S3_BUCKET_RECORDINGS=
S3_BUCKET_TRANSCRIPTS_RAW=
KMS_KEY_ID=

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_SHEET_ID=

# Redaction
# 32-byte hex key for filename HMACs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this stable across runs so the same source file always hashes to the same redacted name.
REDACTION_HMAC_KEY=

# Demo widget auth
DEMO_USERNAME=
DEMO_PASSWORD=

# Server
BACKEND_PORT=8080
LOG_LEVEL=INFO
